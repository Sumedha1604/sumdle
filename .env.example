# Frontend: blank uses same-origin /api requests; set this to the Render URL on Vercel.
VITE_API_BASE_URL=http://localhost:8000

# Backend: omit DATABASE_URL to use backend/data/sumdle.db.
# DATABASE_URL=postgresql://USER:PASSWORD@YOUR-NEON-HOST/sumdle?sslmode=require
CORS_ORIGINS=http://localhost:5173

# Optional local stdio MCP server. Leave command unset to disable MCP enrichment.
# SUMDLE_MCP_COMMAND=node
# SUMDLE_MCP_ARGS=["dist/index.js"]
# SUMDLE_MCP_CWD=/path/to/Word_of_the_day
SUMDLE_MCP_TIMEOUT_SECONDS=3
